# Notes default configuration — copied to notes.ini on
# first launch. An empty db_dir means the default database location
# (~/.local/share/notes/notes.db).
[notes]
db_dir=
code_copy_button=1
code_line_numbers=1
native_menubar=1
sidebar_counts=0
sidebar_fit_content=1
image_viewer=
search_win_w=538
search_win_h=299
first_line_title=1
compact_editor_toolbar=1
editor_win_w=640
editor_win_h=509
touch_assist=0
list_columns=path:0,title:1,modified:1,created:0
action_columns=done:1,action:1,due:1
statusbar_db_path=0
statusbar_note_id=0
show_done_actions=1
list_density_comfortable=1
bold_list_titles=1
# Rotating database backups (see Settings -> Database): off by
# default.  An empty backup_dir means a backups/ folder inside the
# default database location.
backup_enabled=0
backup_dir=
backup_interval_min=60
backup_keep=10
